{
   ignore_libx11_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libX11.so.*
}
{
   ignore_libxext_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libXext.so.*
}
{
   ignore_libmlx_reachable
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libmlx.a
}
{
   ignore_mlx_pixel_put_errors
   Memcheck:Param
   write(buf)
   ...
   fun:mlx_pixel_put
}